{
  "manifest_version": 3,
  "name": "Gmail Sender Search",
  "version": "1.1.0",
  "description": "Search your Gmail inbox or start a filter from a sender in your message list",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
